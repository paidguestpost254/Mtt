"""
MetaTrader 5 connection and order execution layer.
Handles initialization, data fetching, and order placement.
"""

import logging
from datetime import datetime, timedelta
from typing import Optional
import MetaTrader5 as mt5
import pandas as pd

from config import BotConfig

logger = logging.getLogger(__name__)


class MT5Connector:
    """Wrapper around MetaTrader 5 Python API."""

    def __init__(self):
        self.connected: bool = False
        self.account_info = None
        self.paper_balance: float = BotConfig.PAPER_BALANCE
        self._init_mt5()

    def _init_mt5(self) -> None:
        """Initialize MT5 terminal connection."""
        try:
            if not mt5.initialize():
                error = mt5.last_error()
                logger.error(f"MT5 initialization failed: {error}")
                raise ConnectionError(f"MT5 init failed: {error}")

            self.account_info = mt5.account_info()
            if self.account_info is None:
                raise ConnectionError("Could not retrieve account info")

            self.connected = True
            logger.info(
                f"Connected to MT5 | Account: {self.account_info.login} | "
                f"Balance: ${self.account_info.balance:.2f} | "
                f"Equity: ${self.account_info.equity:.2f}"
            )
        except Exception as e:
            logger.error(f"MT5 connection error: {e}")
            raise

    def shutdown(self) -> None:
        """Close MT5 connection gracefully."""
        if self.connected:
            mt5.shutdown()
            self.connected = False
            logger.info("MT5 connection closed.")

    def get_current_price(self) -> tuple:
        """Get current bid and ask prices."""
        tick = mt5.symbol_info_tick(BotConfig.SYMBOL)
        if tick is None:
            raise ConnectionError(f"No tick data for {BotConfig.SYMBOL}")
        return tick.bid, tick.ask

    def get_spread_points(self) -> int:
        """Calculate current spread in points."""
        symbol_info = mt5.symbol_info(BotConfig.SYMBOL)
        if symbol_info is None:
            raise ConnectionError(f"Symbol {BotConfig.SYMBOL} not found")
        tick = mt5.symbol_info_tick(BotConfig.SYMBOL)
        if tick is None:
            return 9999
        spread = (tick.ask - tick.bid) / symbol_info.point
        return int(spread)

    def fetch_ohlcv(self, count: int = None) -> pd.DataFrame:
        """
        Fetch OHLCV candlestick data from MT5.
        Returns DataFrame with columns: open, high, low, close, volume, time
        """
        if count is None:
            count = BotConfig.CANDLE_COUNT

        rates = mt5.copy_rates_from_pos(
            BotConfig.SYMBOL,
            self._timeframe_to_const(BotConfig.TIMEFRAME),
            0,
            count
        )

        if rates is None or len(rates) == 0:
            raise ConnectionError(f"No OHLCV data returned for {BotConfig.SYMBOL}")

        df = pd.DataFrame(rates)
        df["time"] = pd.to_datetime(df["time"], unit="s")
        df = df.set_index("time")
        df = df[["open", "high", "low", "close", "tick_volume"]]
        df.columns = ["open", "high", "low", "close", "volume"]
        logger.debug(f"Fetched {len(df)} candles for {BotConfig.SYMBOL}")
        return df

    def place_order(
        self,
        direction: str,
        lot_size: float,
        sl: float,
        tp: float,
        comment: str = ""
    ) -> Optional[int]:
        """
        Place a market order.
        direction: 'buy' or 'sell'
        Returns ticket number or None on failure.
        """
        if BotConfig.PAPER_TRADING:
            return self._paper_place_order(direction, lot_size, sl, tp, comment)

        symbol_info = mt5.symbol_info(BotConfig.SYMBOL)
        if symbol_info is None:
            logger.error(f"Symbol info not found for {BotConfig.SYMBOL}")
            return None

        tick = mt5.symbol_info_tick(BotConfig.SYMBOL)
        if tick is None:
            logger.error("No tick data available")
            return None

        if direction.lower() == "buy":
            order_type = mt5.ORDER_TYPE_BUY
            price = tick.ask
        else:
            order_type = mt5.ORDER_TYPE_SELL
            price = tick.bid

        request = {
            "action": mt5.TRADE_ACTION_DEAL,
            "symbol": BotConfig.SYMBOL,
            "volume": lot_size,
            "type": order_type,
            "price": price,
            "sl": round(sl, 2),
            "tp": round(tp, 2),
            "deviation": 20,
            "magic": BotConfig.MAGIC_NUMBER,
            "comment": comment[:31],
            "type_time": mt5.ORDER_TIME_GTC,
            "type_filling": mt5.ORDER_FILLING_IOC,
        }

        result = mt5.order_send(request)
        if result is None:
            logger.error(f"Order send failed: {mt5.last_error()}")
            return None

        if result.retcode != mt5.TRADE_RETCODE_DONE:
            logger.error(f"Order rejected: retcode={result.retcode}, comment={result.comment}")
            return None

        ticket = result.order
        logger.info(
            f"ORDER PLACED | {direction.upper()} {lot_size} lots @ {price:.2f} | "
            f"SL: {sl:.2f} | TP: {tp:.2f} | Ticket: {ticket}"
        )
        return ticket

    def close_position(self, ticket: int) -> bool:
        """Close an existing position by ticket."""
        if BotConfig.PAPER_TRADING:
            return self._paper_close_position(ticket)

        position = mt5.positions_get(ticket=ticket)
        if position is None:
            logger.warning(f"Position {ticket} not found")
            return False

        pos = position[0] if isinstance(position, tuple) else position
        tick = mt5.symbol_info_tick(pos.symbol)
        if tick is None:
            return False

        if pos.type == mt5.POSITION_TYPE_BUY:
            close_type = mt5.ORDER_TYPE_SELL
            price = tick.bid
        else:
            close_type = mt5.ORDER_TYPE_BUY
            price = tick.ask

        request = {
            "action": mt5.TRADE_ACTION_DEAL,
            "symbol": pos.symbol,
            "volume": pos.volume,
            "type": close_type,
            "position": pos.ticket,
            "price": price,
            "deviation": 20,
            "magic": BotConfig.MAGIC_NUMBER,
            "comment": "bot_close",
            "type_time": mt5.ORDER_TIME_GTC,
            "type_filling": mt5.ORDER_FILLING_IOC,
        }

        result = mt5.order_send(request)
        if result is None:
            logger.error(f"Close order failed: {mt5.last_error()}")
            return False

        if result.retcode != mt5.TRADE_RETCODE_DONE:
            logger.error(f"Close rejected: {result.retcode} {result.comment}")
            return False

        logger.info(f"Position {ticket} closed.")
        return True

    def get_open_positions(self) -> list:
        """Get all open positions for the bot's magic number."""
        if BotConfig.PAPER_TRADING:
            return self._paper_positions()

        positions = mt5.positions_get(symbol=BotConfig.SYMBOL)
        if positions is None:
            return []

        bot_positions = []
        for pos in positions:
            if pos.magic == BotConfig.MAGIC_NUMBER:
                bot_positions.append(pos)
        return bot_positions

    def get_equity(self) -> float:
        """Get current equity (real or paper)."""
        if BotConfig.PAPER_TRADING:
            return self.paper_balance
        info = mt5.account_info()
        return info.equity if info else 0.0

    def get_daily_pnl(self) -> float:
        """Calculate today's PnL."""
        if BotConfig.PAPER_TRADING:
            return self.paper_balance - BotConfig.PAPER_BALANCE

        history = mt5.history_deals_get(
            datetime.now().replace(hour=0, minute=0, second=0, microsecond=0),
            datetime.now()
        )
        if history is None:
            return 0.0

        pnl = 0.0
        for deal in history:
            if deal.magic == BotConfig.MAGIC_NUMBER:
                pnl += deal.profit + deal.swap + deal.commission
        return pnl

    # --- Paper Trading Simulation ---

    def _paper_place_order(self, direction, lot_size, sl, tp, comment) -> Optional[int]:
        tick = mt5.symbol_info_tick(BotConfig.SYMBOL)
        if tick is None:
            return None

        if direction.lower() == "buy":
            price = tick.ask
        else:
            price = tick.bid

        ticket = int(datetime.now().timestamp() * 1000)
        self._paper_orders = getattr(self, "_paper_orders", [])
        self._paper_orders.append({
            "ticket": ticket,
            "direction": direction.lower(),
            "lot": lot_size,
            "entry": price,
            "sl": sl,
            "tp": tp,
            "time": datetime.now()
        })
        logger.info(f"[PAPER] {direction.upper()} {lot_size} @ {price:.2f} SL:{sl:.2f} TP:{tp:.2f}")
        return ticket

    def _paper_close_position(self, ticket: int) -> bool:
        orders = getattr(self, "_paper_orders", [])
        for i, order in enumerate(orders):
            if order["ticket"] == ticket:
                tick = mt5.symbol_info_tick(BotConfig.SYMBOL)
                if tick is None:
                    return False
                if order["direction"] == "buy":
                    exit_price = tick.bid
                    pnl = (exit_price - order["entry"]) * order["lot"] * 100
                else:
                    exit_price = tick.ask
                    pnl = (order["entry"] - exit_price) * order["lot"] * 100
                self.paper_balance += pnl
                orders.pop(i)
                logger.info(f"[PAPER] Closed ticket {ticket}, PnL: ${pnl:.2f}")
                return True
        return False

    def _paper_positions(self) -> list:
        return getattr(self, "_paper_orders", [])

    # --- Helpers ---

    @staticmethod
    def _timeframe_to_const(tf_minutes: int) -> int:
        mapping = {
            1: mt5.TIMEFRAME_M1,
            5: mt5.TIMEFRAME_M5,
            15: mt5.TIMEFRAME_M15,
            30: mt5.TIMEFRAME_M30,
            60: mt5.TIMEFRAME_H1,
            240: mt5.TIMEFRAME_H4,
            1440: mt5.TIMEFRAME_D1,
        }
        return mapping.get(tf_minutes, mt5.TIMEFRAME_M15)
