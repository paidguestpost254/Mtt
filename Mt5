"""
Multi-indicator trading strategy optimized for Gold (XAUUSD).
Combines trend following, momentum, and mean-reversion signals
with a scoring system to reduce false signals.
"""

import logging
from dataclasses import dataclass
from enum import Enum
from typing import Optional

import numpy as np
import pandas as pd
import ta

from config import BotConfig

logger = logging.getLogger(__name__)


class Signal(str, Enum):
    BUY = "BUY"
    SELL = "SELL"
    NONE = "NONE"


@dataclass
class TradeSignal:
    signal: Signal
    confidence: float  # 0.0 to 1.0
    reason: str
    suggested_sl: float
    suggested_tp: float
    lot_multiplier: float = 1.0  # Scale lot size based on confidence


class GoldStrategy:
    """
    Multi-factor strategy for Gold trading.
    
    Signals are scored across multiple indicator families:
    1. Trend (EMA crossover, ADX)
    2. Momentum (RSI, MACD, Stochastic)
    3. Volatility (ATR, Bollinger Bands)
    4. Volume confirmation
    
    A minimum score threshold must be met before generating a trade signal.
    This reduces whipsaws common in Gold's choppy intraday action.
    """

    SCORE_THRESHOLD: float = 0.65  # Minimum composite score to trade
    MAX_CONFIDENCE: float = 1.0

    def __init__(self):
        self.last_signal: Optional[TradeSignal] = None
        self._indicator_cache: dict = {}

    def analyze(self, df: pd.DataFrame) -> TradeSignal:
        """
        Run full analysis on OHLCV DataFrame.
        Returns a TradeSignal with BUY, SELL, or NONE.
        """
        if len(df) < max(BotConfig.EMA_SLOW, BotConfig.BB_PERIOD, BotConfig.MACD_SLOW) + 10:
            return TradeSignal(Signal.NONE, 0.0, "Insufficient data", 0, 0)

        # Compute all indicators
        indicators = self._compute_indicators(df)

        # Score each component
        trend_score = self._score_trend(indicators)
        momentum_score = self._score_momentum(indicators)
        volatility_score = self._score_volatility(indicators)
        volume_score = self._score_volume(df, indicators)

        # Weighted composite score
        # Trend is most important for Gold directional moves
        weights = {
            "trend": 0.40,
            "momentum": 0.30,
            "volatility": 0.15,
            "volume": 0.15,
        }

        composite_buy = (
            weights["trend"] * trend_score["buy"] +
            weights["momentum"] * momentum_score["buy"] +
            weights["volatility"] * volatility_score["buy"] +
            weights["volume"] * volume_score["buy"]
        )

        composite_sell = (
            weights["trend"] * trend_score["sell"] +
            weights["momentum"] * momentum_score["sell"] +
            weights["volatility"] * volatility_score["sell"] +
            weights["volume"] * volume_score["sell"]
        )

        # Determine signal
        if composite_buy >= self.SCORE_THRESHOLD and composite_buy > composite_sell:
            confidence = min(composite_buy, self.MAX_CONFIDENCE)
            reason = self._build_reason(trend_score, momentum_score, volatility_score, volume_score, "BUY")
            sl, tp = self._calculate_stops(df, "buy", indicators)
            lot_mult = self._confidence_to_lot(confidence)
            signal = TradeSignal(Signal.BUY, confidence, reason, sl, tp, lot_mult)
            logger.info(f"SIGNAL: BUY | Confidence: {confidence:.2f} | {reason}")
            self.last_signal = signal
            return signal

        elif composite_sell >= self.SCORE_THRESHOLD and composite_sell > composite_buy:
            confidence = min(composite_sell, self.MAX_CONFIDENCE)
            reason = self._build_reason(trend_score, momentum_score, volatility_score, volume_score, "SELL")
            sl, tp = self._calculate_stops(df, "sell", indicators)
            lot_mult = self._confidence_to_lot(confidence)
            signal = TradeSignal(Signal.SELL, confidence, reason, sl, tp, lot_mult)
            logger.info(f"SIGNAL: SELL | Confidence: {confidence:.2f} | {reason}")
            self.last_signal = signal
            return signal

        else:
            reason = f"No signal | Buy:{composite_buy:.2f} Sell:{composite_sell:.2f} (threshold:{self.SCORE_THRESHOLD})"
            logger.debug(reason)
            return TradeSignal(Signal.NONE, max(composite_buy, composite_sell), reason, 0, 0)

    def _compute_indicators(self, df: pd.DataFrame) -> dict:
        """Compute all technical indicators in one pass."""
        ind = {}

        # EMAs
        ind["ema_fast"] = ta.trend.ema_indicator(df["close"], window=BotConfig.EMA_FAST)
        ind["ema_slow"] = ta.trend.ema_indicator(df["close"], window=BotConfig.EMA_SLOW)

        # ADX
        adx = ta.trend.adx(df["high"], df["low"], df["close"], window=14)
        ind["adx"] = adx
        ind["plus_di"] = ta.trend.plus_di_index(df["high"], df["low"], df["close"], window=14)
        ind["minus_di"] = ta.trend.minus_di_index(df["high"], df["low"], df["close"], window=14)

        # RSI
        ind["rsi"] = ta.momentum.rsi(df["close"], window=BotConfig.RSI_PERIOD)

        # MACD
        macd = ta.trend.macd(df["close"], window_slow=BotConfig.MACD_SLOW,
                             window_fast=BotConfig.MACD_FAST,
                             window_sign=BotConfig.MACD_SIGNAL)
        ind["macd"] = macd["MACD"]
        ind["macd_signal"] = macd["MACD_Signal"]
        ind["macd_hist"] = macd["MACD_Hist"]

        # Stochastic
        stoch = ta.momentum.stochastic(df["high"], df["low"], df["close"],
                                       wi
