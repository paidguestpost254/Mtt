    def validate(cls) -> None:
        """Validate configuration at startup."""
        assert cls.SYMBOL, "Symbol must be set"
        assert cls.LOT_SIZE > 0, "Lot size must be positive"
        assert cls.SL_POINTS > 0, "SL must be positive"
        assert cls.TP_POINTS > 0, "TP must be positive"
        if cls.ENABLE_SESSION_FILTER:
