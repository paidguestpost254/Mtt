    """Central configuration for the trading bot."""

    # --- Symbol & Timeframe ---
    SYMBOL: str = "XAUUSD"          # Gold symbol (adjust to your broker: XAUUSD.m, GOLD, etc.)
    TIMEFRAME: int = 1             # M1 = 1, M5 = 5, M15 = 15, H1 = 60
    CANDLE_COUNT: int = 300        # Number of candles to fetch for analysis

    # --- Trading Parameters ---
    LOT_SIZE: float = 0.01         # Base lot size (adjust based on account balance)
    MAX_POSITIONS: int = 1         # Max concurrent positions
    MAGIC_NUMBER: int = 20240901   # Unique ID for bot's orders

    # --- Risk Management ---
    RISK_PER_TRADE_PCT: float = 1.0    # Risk % of equity per trade
    MAX_DAILY_LOSS_PCT: float = 3.0    # Stop trading if daily loss exceeds this
    MAX_DAILY_PROFIT_PCT: float = 5.0  # Stop trading if daily profit exceeds this
    SL_POINTS: int = 200             # Stop Loss in points (200 pts = $2.00 on gold)
    TP_POINTS: int = 400             # Take Profit in points (400 pts = $4.00 on gold)
    TRAILING_SL_POINTS: int = 150    # Trailing stop distance
    TRAILING_START_POINTS: int = 100 # Start trailing after this profit

    # --- Strategy Parameters ---
    EMA_FAST: int = 9
    EMA_SLOW: int = 21
    RSI_PERIOD: int = 14
    RSI_OVERBOUGHT: float = 70.0
    RSI_OVERSOLD: float = 30.0
    MACD_FAST: int = 12
    MACD_SLOW: int = 26
    MACD_SIGNAL: int = 9
    ATR_PERIOD: int = 14
    BB_PERIOD: int = 20
    BB_STD_DEV: float = 2.0
    VOLUME_SPIKE_MULTIPLIER: float = 1.5

    # --- Session Filter (Gold trades best during London/NY overlap) ---
    ENABLE_SESSION_FILTER: bool = True
    TRADING_START_HOUR: int = 8       # 8 AM server time
    TRADING_END_HOUR: int = 20        # 8 PM server time

    # --- Spread Filter ---
    MAX_SPREAD_POINTS: int = 50       # Skip entry if spread > this (in points)

    # --- Telegram Notifications ---
    TELEGRAM_BOT_TOKEN: str = os.getenv("TELEGRAM_BOT_TOKEN", "")
    TELEGRAM_CHAT_ID: str = os.getenv("TELEGRAM_CHAT_ID", "")
    ENABLE_NOTIFICATIONS: bool = True

    # --- Logging ---
    LOG_FILE: str = "trading_bot.log"
